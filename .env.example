# Postgres. `docker compose up -d` starts one that matches this URL.
DATABASE_URL=postgres://assistant:assistant@localhost:5434/assistant

# Public URL of the Next.js app. Used for auth and the Composio OAuth callback.
APP_URL=http://localhost:3000

# Dashboard auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated addresses allowed to create an account.
ALLOWED_EMAILS=founder@example.com

# Trigger.dev. The secret key is per environment (dev key locally, prod key in production).
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Composio. Use a dedicated project: it has one webhook subscription, and
# `pnpm webhooks:setup` points it at Trigger.dev.
COMPOSIO_API_KEY=

# Model provider.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Record prompts and completions (which contain email content) on trace spans.
# Defaults to true in development and false in production.
# AI_TRACE_CONTENT=true

# How long a proposal waits for a decision before it expires.
APPROVAL_TTL_HOURS=48
